qsf_to_json:
  input_file: data/{{ output_filename }}/raw_data/{{ qsf_filename }}
  output_file: data/{{ output_filename }}/wave_qsf_json/{{ qsf_basename }}_flow.json

csv_to_fill_answers:
  input_survey_template: data/{{ output_filename }}/wave_qsf_json/{{ qsf_basename }}_flow.json
  input_csv_file: data/{{ output_filename }}/raw_data/{{ csv_filename }}
  output_dir: data/{{ output_filename }}/response_json
  limit: -1

text_simulation:
  personas_to_texts:
    persona_json_dir: data/mega_persona_json/mega_persona
    output_text_dir: text_simulation/text_personas
    persona_variant: full

  questions_to_texts:
    input_path: data/{{ output_filename }}/response_json
    output_dir: text_simulation/{{ output_filename }}/text_questions
    include_reasoning: {{ include_reasoning | string | lower }}

  create_text_simulation_input:
    persona_text_dir: {{ persona_text_dir }}
    question_prompts_dir: text_simulation/{{ output_filename }}/text_questions
    output_combined_prompts_dir: text_simulation/{{ output_filename }}/text_simulation_input
    persona_prompt_header: |
      {{ persona_prompt_header }}
    persona_question_prompt_separator: |
      {{ persona_question_prompt_separator }}
    empty_persona_prompt: {{ empty_persona_prompt | string | lower }}
    combine_prompt_end: {{ combine_prompt_end }}
  
  LLM_simulation:
    input_dir: text_simulation/{{ output_filename }}/text_simulation_input
    output_dir: text_simulation/{{ output_filename }}/text_simulation_output
    question_json_base_dir: data/{{ output_filename }}/response_json
    output_updated_questions_dir: text_simulation/{{ output_filename }}/response_json_llm_imputed
    system_instruction: |
      {{ system_instruction | replace('\n', '\n      ') }}
    LLM_config:
      provider: "{{ llm_provider }}"
      model_name: "{{ model_name }}"
      temperature: {{ temperature }}
      max_tokens: {{ max_tokens }}
      max_retries: {{ max_retries }}
    num_workers: {{ num_workers }}
    force_regenerate: {{ force_regenerate | string | lower }}
    max_personas: {{ max_personas }}

  convert_to_csv:
    input_json_dir: text_simulation/{{ output_filename }}/response_json_llm_imputed
    reference_csv_path: data/{{ output_filename }}/raw_data/{{ csv_filename }}
    output_dir: text_simulation/{{ output_filename }}/csv_output